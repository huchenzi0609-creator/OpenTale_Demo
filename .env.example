# Copy to .env.local. Keep secrets only in that ignored, owner-readable file.
OPENTALE_API_KEY=
OPENTALE_BASE_URL=https://api.deepseek.com
OPENTALE_MODEL=deepseek-flash
OPENTALE_TIMEOUT_SECONDS=90
OPENTALE_MAX_OUTPUT_TOKENS=1600
# Per-request soft context target; independent of total experiment/token budgets.
# Exact source excerpts are used only after lossless text sharing and catalog packing.
OPENTALE_CONTEXT_TARGET_CHARS=96000
OPENTALE_PORT=8231
